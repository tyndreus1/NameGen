# xAI (Grok). Optional — without a key the font path is used as fallback.
# Edits use POST https://api.x.ai/v1/images/edits (JSON, not multipart).
# Text-only (XAI_REF_COUNT=0) uses POST https://api.x.ai/v1/images/generations.
XAI_API_KEY=

# grok-imagine-image | grok-imagine-image-2.0 | grok-imagine-image-quality
XAI_IMAGE_MODEL=grok-imagine-image-2.0

# 0 = text-only (style description in prompts/style-description.md)
# 1 or 2 = image-to-image edits with that many owner references.
# Default 1: cheaper than 2 refs (each input image is billed).
XAI_REF_COUNT=1

# 1k (default, cheaper) or 2k (laser-quality PNG, ~$0.02 more).
XAI_RESOLUTION=1k

# Extra rounds after the first n-batch for slots that failed validation. Default 2.
XAI_MAX_RETRIES=2

# Vision / text model for spelling checks (chat completions + image input).
XAI_TEXT_MODEL=grok-4.6

# HMAC secret used to sign top-up codes. Required. Use a long random string.
CODE_SECRET=change-me-to-a-long-random-string

# Admin panel password (page at /admin). Required for admin UI.
ADMIN_PASSWORD=change-me

# Signed session cookies. Required. Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Prisma SQLite URL (local/dev). For production, use a persistent volume or a hosted Postgres URL.
DATABASE_URL="file:./dev.db"
