# xAI (Grok). Optional — without a key the font path is used as fallback.
# Edits use POST https://api.x.ai/v1/images/edits (JSON, not multipart).
# Text-only (XAI_REF_COUNT=0) uses POST https://api.x.ai/v1/images/generations.
XAI_API_KEY=

# grok-imagine-image | grok-imagine-image-2.0 | grok-imagine-image-quality
XAI_IMAGE_MODEL=grok-imagine-image-2.0

# 0 = text-only (worse quality; keep as an option only).
# 1 (default) or 2 = /images/edits. Each request bills the reference once, not per output.
# Cost at 2.0 + quality=low: n * $0.04 + $0.01 per reference.
XAI_REF_COUNT=1

# Edits default to medium (+$0.02/image). Pin low.
XAI_QUALITY=low

# Variety: 2 requests of n=2, each with a different reference (~$0.18 / 4 designs).
# One request of n=4 is cheaper ($0.17) but the designs look almost identical.
XAI_BATCHES=2
XAI_N_PER_BATCH=2

# 1k (default, cheaper) or 2k (laser-quality PNG).
XAI_RESOLUTION=1k

# Extra rounds after the variety batches; each retry asks n = failed slots only.
XAI_MAX_RETRIES=2

# Vision / text model for spelling checks (chat completions + image input).
XAI_TEXT_MODEL=grok-4.6

# HMAC secret used to sign top-up codes. Required. Use a long random string.
CODE_SECRET=change-me-to-a-long-random-string

# Admin panel password (page at /admin). Required for admin UI.
ADMIN_PASSWORD=change-me

# Signed session cookies. Required. Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Prisma SQLite URL (local/dev). For production, use a persistent volume or a hosted Postgres URL.
DATABASE_URL="file:./dev.db"

# Where admin-uploaded reference PNGs are stored (cleaned B/W). Must be a
# persistent disk in production. Default: data/references (gitignored).
# Categories, assignments, and generation settings live in the database —
# that must persist too (SQLite file on a volume, or hosted Postgres).
REFERENCE_STORAGE_DIR=data/references

# Credit wallet. `local` (default) uses this app's SQLite User.credits +
# CreditSpend ledger. `remote` selects the IdeaLaserStudio stub in
# src/lib/credits/remote.ts — HTTP is not implemented yet.
CREDITS_PROVIDER=local
# CREDITS_API_URL=https://credits.example/api
# CREDITS_API_KEY=
