# xAI (Grok) image-to-image. Optional — without a key the font path is used as fallback.
# The app calls POST https://api.x.ai/v1/images/edits with a JSON body (not multipart;
# the OpenAI SDK images.edit() does not work against this endpoint).
XAI_API_KEY=

# Image model on the xAI Images API. Live test favored grok-imagine-image-2.0
# over grok-imagine-image-quality. Also available: grok-imagine-image.
XAI_IMAGE_MODEL=grok-imagine-image-2.0

# Vision / text model for spelling checks (chat completions + image input).
XAI_TEXT_MODEL=grok-4.6

# HMAC secret used to sign top-up codes. Required. Use a long random string.
CODE_SECRET=change-me-to-a-long-random-string

# Admin panel password (page at /admin). Required for admin UI.
ADMIN_PASSWORD=change-me

# Signed session cookies. Required. Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Prisma SQLite URL (local/dev). For production, use a persistent volume or a hosted Postgres URL.
DATABASE_URL="file:./dev.db"
