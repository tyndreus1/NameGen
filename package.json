{
  "name": "namegen",
  "version": "0.1.0",
  "private": true,
  "description": "Laser-cut name necklace design generator",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "codes": "tsx scripts/generate-codes.ts",
    "preview": "tsx scripts/preview-designs.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "@resvg/resvg-js": "^2.6.2",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "jose": "^6.1.0",
    "next": "^15.5.4",
    "opentype.js": "^1.3.4",
    "potrace": "^2.1.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.34.4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/opentype.js": "^1.3.8",
    "@types/potrace": "^2.1.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prisma": "^6.16.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
